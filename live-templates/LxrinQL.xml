<templateSet group="LxrinQL">

  <!--
    qlid  –  Insert the next persisted auto-incrementing long ID (starts at 1000).

    How it works:
      The counter is stored in a plain text file  ~/.lxrin_ql_id_seq  in your
      home directory.  Every time you expand "qlid" the file is read, the
      counter is incremented by 1, written back, and the new value is inserted
      as a Java long literal (e.g. 1001L).  Because the file persists on disk
      the counter survives IDE restarts.

    Import into IntelliJ:
      File → Manage IDE Settings → Import Settings → select this file
      -or-
      Copy this file to  <IDE config dir>/templates/LxrinQL.xml
      (on macOS: ~/Library/Application Support/JetBrains/<product>/templates/)

    Usage:
      In any Java file type  qlid  then press  Ctrl+Space  (or Tab).
      The cursor is left after the inserted literal so you can continue typing.
  -->
  <template
      name="qlid"
      value="$ID$L"
      description="Insert next persisted auto-increment long ID (starts at 1000)"
      toReformat="false"
      toShortenFQNames="true">

    <variable
        name="ID"
        expression="groovyScript(&quot;def f = new File(System.getProperty('user.home') + File.separator + '.lxrin_ql_id_seq'); long n = 1000; if (f.exists()) { try { n = f.text.trim().toLong() + 1 } catch (Exception e) { n = 1000 } }; f.text = n.toString(); n&quot;)"
        defaultValue="1000"
        alwaysStopAt="false"/>

    <context>
      <option name="JAVA_CODE" value="true"/>
    </context>
  </template>

</templateSet>
